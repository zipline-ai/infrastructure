orchestration = {
  deployment = {
    customer_name   = "public-demo"
    artifact_prefix = "s3://zipline-public-demo-artifacts"
    zipline_version = "nightly"
    deploy_fetcher  = true
  }

  # Empty domain uses the AWS NLB DNS name directly. Add DNS/TLS later by setting
  # domain and cert-manager fields here.
  ingress = {
    domain = ""
  }

  # The raw AWS NLB demo endpoint is HTTP-only until DNS/TLS is configured.
  # Keep this scheme aligned with the URL users load in the browser, otherwise
  # SvelteKit rejects POST-based UI actions such as online feature fetches.
  ui = {
    origin = "http://k8s-ziplines-ziplineo-82549f7164-cb3dfbbafd5a0571.elb.us-west-2.amazonaws.com"
  }

  image_pull_secret = {
    create             = true
    dockerhub_username = "ziplineai"
    dockerhub_token    = ""
  }

  compute = {
    default_namespace = "zipline-default"
    namespaces = [
      { name = "zipline-default", team = "default" },
    ]
  }

  # Enable Google auth after creating the OAuth client and secret values in AWS.
  auth = {
    enabled                = false
    google_oauth_client_id = ""
  }

  values = {
    orchestration = {
      fetcher = {
        replicas = 1
        resources = {
          requests = { cpu = "1", memory = "2Gi" }
          limits   = { cpu = "2", memory = "4Gi" }
        }
      }
    }
  }
}

aws = {
  region           = "us-west-2"
  cluster_name     = "public-demo-eks"
  warehouse_bucket = "zipline-public-demo-warehouse"
  kv_table_prefix  = "PUBLIC_DEMO_"
  eks_instance_type = "m8a.large"
  eks_desired_size  = 2
  eks_min_size      = 2
  eks_max_size      = 4

  # Omit vpc_id/primary_subnet_id/secondary_subnet_id to let the wrapper create a
  # disposable VPC for the weekly-reset platform.

  database_instance_class        = "db.t3.medium"
  database_multi_az              = false
  database_backup_retention_days = 0
  database_skip_final_snapshot   = true
  bucket_force_destroy           = true
  secret_force_delete            = true

  additional_data_buckets = [
    "zipline-public-demo-curated",
  ]

  karpenter = {
    pool_limits     = { cpu = "200", memory = "800Gi" }
    driver_limits   = { cpu = "40", memory = "160Gi" }
    executor_limits = { cpu = "200", memory = "800Gi" }
  }
}
