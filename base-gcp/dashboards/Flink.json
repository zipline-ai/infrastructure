                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "outputFullDuration": false,
                  "prometheusQuery": "sum by (feature_group) (flink_taskmanager_job_task_operator_chronon_feature_group_event_created_to_sink_time{quantile=\"0.99\"})\n",
                  "unitOverride": "ms"
                }
              }
            ],
            "thresholds": [],
