                "timeSeriesQuery": {
                  "outputFullDuration": false,
                  "prometheusQuery": "sum by (job_name) (rate(flink_taskmanager_job_task_operator_chronon_feature_group_kvstore_writer_successes[5m]))\n",
                  "unitOverride": "1"
                }
              }
            ],
            "thresholds": [],
            "yAxis": {
              "label": "",
              "scale": "LINEAR"
            }
          }
        }
      },
      {
        "yPos": 48,
        "height": 16,
        "width": 24,
        "widget": {
          "title": "Feature Freshness Latency by job name ",
          "id": "",
